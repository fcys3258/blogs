---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InlineMath from "../../components/InlineMath.astro";
import TagBadge from "../../components/TagBadge.astro";
import { render } from "astro:content";
import { formatPostDate } from "../../lib/dates";
import { renderInlineMath } from "../../lib/inlineMath";
import { getPublishedPosts, postPath, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = { post: Post };

const { post } = Astro.props;
const { Content, headings } = await render(post);

function extractRawHeadings(rawBody: string): string[] {
  const headingRegex = /^(#{2,3})\s+(.+)$/gm;
  return Array.from(rawBody.matchAll(headingRegex), (match) => match[2].trim());
}

function stripInlineMarkdown(value: string): string {
  return value
    .replace(/!\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .replace(/[*_~]/g, "")
    .split(String.fromCharCode(96))
    .join("")
    .replace(/\s+/g, " ");
}

// Astro's heading text includes both KaTeX's MathML and visual fallback text.
// Render math from the raw Markdown once so ToC labels match article headings.
function renderTocHeading(rawHeading: string): string {
  return renderInlineMath(rawHeading, stripInlineMarkdown);
}

const renderedHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);
const rawHeadings = extractRawHeadings(post.body ?? "");
const tocHeadings = renderedHeadings.map((heading, index) => ({
  ...heading,
  html: renderTocHeading(rawHeadings[index] ?? heading.text),
}));
const { title, date, tags, demo } = post.data;
const dateTime = date.toISOString();
const formattedDate = formatPostDate(date);

// All posts sorted by date for prev/next navigation
const allPosts = await getPublishedPosts();
const currentIdx = allPosts.findIndex((candidate) => candidate.id === post.id);
const prevPost = currentIdx < allPosts.length - 1 ? allPosts[currentIdx + 1] : null;
const nextPost = currentIdx > 0 ? allPosts[currentIdx - 1] : null;

// Dynamically load demo component if specified in frontmatter
let DemoComponent: any = null;
if (demo) {
  const modules = import.meta.glob<{ default: any }>(
    "../../components/demos/*.astro",
    { eager: true }
  );
  const matchKey = Object.keys(modules).find((key) =>
    key.endsWith(`/${demo}.astro`)
  );
  if (!matchKey) {
    throw new Error(`文章 ${post.id} 引用了不存在的实验组件：${demo}`);
  }
  DemoComponent = modules[matchKey]!.default;
}
---

<BaseLayout title={title} description={post.data.description} totalPosts={allPosts.length} type="article">
  <div class="article-layout">
    <!-- ToC Sidebar -->
    {tocHeadings.length > 0 && (
      <aside class="toc-sidebar" id="toc-sidebar">
        <div class="toc-heading">目录</div>
        <nav>
          <ul>
            {tocHeadings.map((heading) => (
              <li>
                <a
                  href={`#${heading.slug}`}
                  class={`toc-h${heading.depth}`}
                  data-toc-link
                >
                  <span set:html={heading.html} />
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}

    <!-- Main content -->
    <div class="article-main">
      <article class="article">
        <header class="article-header">
          <h1 class="article-title"><InlineMath text={title} /></h1>
          <div class="article-meta">
            <time datetime={dateTime}>{formattedDate}</time>
            {tags.length > 0 && (
              <span class="article-tags">
                {tags.map((tag) => <TagBadge tag={tag} />)}
              </span>
            )}
          </div>
        </header>

        <div class="article-body">
          <Content />
        </div>
      </article>

      {DemoComponent && (
        <div class="demo-section">
          <h2 class="demo-heading">🧪 实验区</h2>
          <div class="demo-body">
            <DemoComponent />
          </div>
        </div>
      )}

      <!-- Prev/Next Navigation -->
      <nav class="article-nav">
        <div class="prev">
          {prevPost && (
            <a href={postPath(prevPost)}>
              <span class="nav-label">← 上一篇文章</span>
              <InlineMath text={prevPost.data.title} />
            </a>
          )}
        </div>
        <div class="next">
          {nextPost && (
            <a href={postPath(nextPost)}>
              <span class="nav-label">下一篇文章 →</span>
              <InlineMath text={nextPost.data.title} />
            </a>
          )}
        </div>
      </nav>

      <nav class="back-nav">
        <a href="/">&larr; 返回文章列表</a>
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .article {
    padding: 2.5rem 0 1rem;
  }
  .article-header {
    margin-bottom: 2rem;
  }
  .article-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-heading);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }
  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.82rem;
    color: var(--text-light);
  }
  .article-tags {
    display: flex;
    gap: 0.35rem;
  }
</style>

{tocHeadings.length > 0 && (
  <button
    type="button"
    class="toc-toggle"
    id="toc-toggle"
    aria-label="打开目录"
    aria-controls="toc-sidebar"
    aria-expanded="false"
  >☰</button>
)}

<script>
  const tocToggle = document.getElementById("toc-toggle") as HTMLButtonElement | null;
  const tocSidebar = document.getElementById("toc-sidebar");

  function setTocOpen(open: boolean) {
    if (!tocToggle || !tocSidebar) return;
    tocSidebar.classList.toggle("open", open);
    tocToggle.textContent = open ? "✕" : "☰";
    tocToggle.setAttribute("aria-expanded", String(open));
    tocToggle.setAttribute("aria-label", open ? "关闭目录" : "打开目录");
  }

  tocToggle?.addEventListener("click", () => {
    setTocOpen(!tocSidebar?.classList.contains("open"));
  });

  document.querySelectorAll("[data-toc-link]").forEach((link) => {
    link.addEventListener("click", () => setTocOpen(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setTocOpen(false);
  });

  const tocLinks = document.querySelectorAll("[data-toc-link]");
  const articleHeadings = document.querySelectorAll(
    ".article-body h2, .article-body h3",
  );

  if (tocLinks.length > 0 && articleHeadings.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.find((entry) => entry.isIntersecting);
        if (!visible) return;
        const id = visible.target.id;
        tocLinks.forEach((link) => {
          link.classList.toggle("active", link.getAttribute("href") === `#${id}`);
        });
      },
      { rootMargin: "-80px 0px -70% 0px" },
    );
    articleHeadings.forEach((heading) => observer.observe(heading));
  }
</script>
