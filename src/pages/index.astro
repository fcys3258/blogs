---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getPublishedPosts, postPath, tagPath } from "../lib/posts";
import { SITE_CONFIG } from "../site.config.ts";

const PAGE_SIZE = SITE_CONFIG.pagination.pageSize;
const posts = await getPublishedPosts();

const tagCounts = new Map<string, number>();
posts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  });
});
const allTags = [...tagCounts.entries()].sort(
  ([firstTag, firstCount], [secondTag, secondCount]) =>
    secondCount - firstCount || firstTag.localeCompare(secondTag, "zh-CN"),
);
---

<BaseLayout description={SITE_CONFIG.description} totalPosts={posts.length}>
  <div class="container">
    <section class="hero">
      <h1 class="hero-title">{SITE_CONFIG.title}</h1>
      <p class="hero-sub">{SITE_CONFIG.description}</p>
    </section>

    <div class="controls-bar">
      {allTags.length > 0 && (
        <div class="tag-filter-section">
          <nav class="tag-filter is-collapsed" id="tag-filter" aria-label="文章标签">
            <a href="/" class="tag-filter-item active">全部</a>
            {allTags.map(([tag, count]) => (
              <a href={tagPath(tag)} class="tag-filter-item" title={`${count} 篇文章`}>
                {tag}
              </a>
            ))}
          </nav>
        </div>
      )}
      <div class="controls-actions">
        {allTags.length > 0 && (
          <button
            type="button"
            class="tag-toggle"
            id="tag-toggle"
            aria-controls="tag-filter"
            aria-expanded="false"
            hidden
          >
            <span id="tag-toggle-label">展开更多</span>
            <span class="tag-toggle-icon" aria-hidden="true">⌄</span>
          </button>
        )}
        <button
          type="button"
          class="sort-btn"
          id="sort-btn"
          title="切换排序"
          aria-label="切换为最早文章在前"
        >
          <span id="sort-icon">🕐</span>
          <span id="sort-label">最新在前</span>
        </button>
      </div>
    </div>

    <section class="post-list" id="post-list">
      {posts.map((post) => (
        <div class="post-item" data-date={post.data.date.toISOString()} data-id={post.id}>
          <ArticleCard
            title={post.data.title}
            date={post.data.date}
            href={postPath(post)}
            tags={post.data.tags}
            description={post.data.description}
          />
        </div>
      ))}
      {posts.length === 0 && (
        <p class="empty">还没有文章。请在 content/posts 中添加 Markdown 文件。</p>
      )}
    </section>

    <div class="pagination" id="pagination"></div>
    <div id="page-data" data-page-size={PAGE_SIZE} hidden></div>
  </div>
</BaseLayout>

<style>
  .controls-bar {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-light);
    margin-bottom: 0.5rem;
  }
  .tag-filter {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    position: relative;
    overflow: hidden;
  }
  .tag-filter-section {
    width: 100%;
  }
  .controls-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 0.35rem;
  }
  .tag-filter.is-collapsed {
    max-height: var(--tag-filter-collapsed-height, 3.6rem);
  }
  .tag-filter.is-expanded {
    max-height: none;
  }
  .tag-filter-item {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.2rem 0.65rem;
    border-radius: 4px;
    background: var(--accent-bg);
    line-height: 1.5;
    white-space: nowrap;
  }
  .tag-filter-item:hover,
  .tag-filter-item.active {
    background: var(--accent);
    color: white;
    text-decoration: none;
  }
  .tag-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: 0.75rem;
    cursor: pointer;
  }
  .tag-toggle:hover {
    color: var(--accent);
  }
  .tag-toggle[hidden] {
    display: none;
  }
  .tag-toggle-icon {
    display: inline-block;
    transition: transform 0.15s ease;
  }
  .tag-toggle[aria-expanded="true"] .tag-toggle-icon {
    transform: rotate(180deg);
  }
  .sort-btn {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    font-size: 0.78rem;
    color: var(--text-muted);
    cursor: pointer;
    white-space: nowrap;
    font-family: inherit;
    margin-left: auto;
  }
  .sort-btn:hover {
    background: var(--bg-hover);
  }
  .hero {
    padding: 3rem 0 1.5rem;
  }
  .hero-title {
    font-size: 2rem;
    margin-bottom: 0.35rem;
  }
  .hero-sub {
    color: var(--text-light);
    font-size: 0.95rem;
  }
  .post-list {
    padding: 0.5rem 0 1rem;
  }
  .post-item {
    display: block;
  }
  .post-item.hidden {
    display: none;
  }
  .empty {
    padding: 3rem 0;
    color: var(--text-light);
    text-align: center;
  }
</style>

<script>
  import { initPostListControls } from "../scripts/postListControls";
  initPostListControls();
</script>
