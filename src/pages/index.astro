---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getCollection } from "astro:content";
import { SITE_CONFIG } from "../site.config.ts";

const PAGE_SIZE = SITE_CONFIG.pagination.pageSize;
const allPosts = await getCollection("posts");
const posts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout description="计算数学学习笔记" totalPosts={posts.length}>
  <div class="container">
    <section class="hero">
      <h1 class="hero-title">数值笔记</h1>
      <p class="hero-sub">计算数学学习笔记 · 理论推导 + 交互式数值实验</p>
    </section>

    <div class="controls-bar">
      {allTags.length > 0 && (
        <nav class="tag-filter">
          <a href="/" class="tag-filter-item active">全部</a>
          {allTags.map((tag) => (
            <a href={`/tags/${tag}`} class="tag-filter-item">{tag}</a>
          ))}
        </nav>
      )}
      <button class="sort-btn" id="sort-btn" title="切换排序">
        <span id="sort-icon">🕐</span>
        <span id="sort-label">最新在前</span>
      </button>
    </div>

    <section class="post-list" id="post-list">
      {posts.map((post) => (
        <div class="post-item" data-date={post.data.date.toISOString()}>
          <ArticleCard
            title={post.data.title}
            date={post.data.date}
            slug={post.slug}
            tags={post.data.tags}
            description={post.data.description}
          />
        </div>
      ))}
    </section>

    <div class="pagination" id="pagination"></div>
    <div id="page-data" data-page-size={PAGE_SIZE} hidden></div>
  </div>
</BaseLayout>

<style>
  .controls-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-light);
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }
  .tag-filter {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    flex: 1;
  }
  .tag-filter-item {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.2rem 0.65rem;
    border-radius: 4px;
    background: var(--accent-bg);
  }
  .tag-filter-item:hover,
  .tag-filter-item.active {
    background: var(--accent);
    color: white;
    text-decoration: none;
  }
  .sort-btn {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    font-size: 0.78rem;
    color: var(--text-muted);
    cursor: pointer;
    white-space: nowrap;
    font-family: inherit;
  }
  .sort-btn:hover {
    background: var(--bg-hover);
  }
  .hero {
    padding: 3rem 0 1.5rem;
  }
  .hero-title {
    font-size: 2rem;
    margin-bottom: 0.35rem;
  }
  .hero-sub {
    color: var(--text-light);
    font-size: 0.95rem;
  }
  .post-list {
    padding: 0.5rem 0 1rem;
  }
  .post-item {
    display: block;
  }
  .post-item.hidden {
    display: none;
  }
  .empty {
    padding: 3rem 0;
    color: var(--text-light);
    text-align: center;
  }

  /* Pagination */
  .pagination {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.35rem;
    padding: 1.5rem 0 2rem;
    font-size: 0.82rem;
  }
  .pagination .page-btn {
    min-width: 2rem;
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    color: var(--text-muted);
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    font-size: 0.82rem;
    font-family: inherit;
    transition: all 0.15s;
  }
  .pagination .page-btn:hover {
    background: var(--bg-hover);
    border-color: var(--text-muted);
  }
  .pagination .page-btn.active {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
    font-weight: 500;
  }
  .pagination .page-btn.disabled {
    opacity: 0.35;
    pointer-events: none;
  }
  .pagination .page-ellipsis {
    padding: 0 0.15rem;
    color: var(--text-light);
  }
</style>

<script>
  const PAGE_SIZE = parseInt(document.getElementById("page-data")!.dataset.pageSize || "15");
  const postItems = Array.from(document.querySelectorAll(".post-item")) as HTMLElement[];
  const totalPages = Math.ceil(postItems.length / PAGE_SIZE);

  function getParams() {
    const p = new URLSearchParams(window.location.search);
    const page = Math.max(1, parseInt(p.get("page") || "1") || 1);
    const sort = p.get("sort") === "asc" ? "asc" : "desc";
    return { page, sort };
  }

  function updateParams(page: number, sort: string) {
    const p = new URLSearchParams();
    if (page > 1) p.set("page", String(page));
    if (sort === "asc") p.set("sort", "asc");
    const qs = p.toString();
    const url = qs ? `/?${qs}` : "/";
    window.history.replaceState(null, "", url);
  }

  function applySort(sort: string) {
    const list = document.getElementById("post-list")!;
    // Query live DOM order
    const items = Array.from(list.querySelectorAll(".post-item")) as HTMLElement[];
    items.sort((a, b) => {
      const da = a.dataset.date || "";
      const db = b.dataset.date || "";
      return sort === "asc" ? da.localeCompare(db) : db.localeCompare(da);
    });
    items.forEach((item) => list.appendChild(item));
  }

  function showPage(page: number) {
    const list = document.getElementById("post-list")!;
    const items = Array.from(list.querySelectorAll(".post-item")) as HTMLElement[];
    const start = (page - 1) * PAGE_SIZE;
    const end = start + PAGE_SIZE;
    items.forEach((item, i) => {
      item.classList.toggle("hidden", i < start || i >= end);
    });
  }

  function renderPagination(page: number, sort: string) {
    const container = document.getElementById("pagination")!;
    if (totalPages <= 1) {
      container.innerHTML = "";
      return;
    }

    let html = "";
    // Prev
    html += `<a href="?page=${Math.max(1, page - 1)}&sort=${sort}" class="page-btn ${page <= 1 ? "disabled" : ""}" data-page="${page - 1}">←</a>`;

    // Page numbers
    const pages: (number | string)[] = [];
    if (totalPages <= 7) {
      for (let i = 1; i <= totalPages; i++) pages.push(i);
    } else {
      pages.push(1);
      if (page > 3) pages.push("...");
      for (let i = Math.max(2, page - 1); i <= Math.min(totalPages - 1, page + 1); i++) {
        pages.push(i);
      }
      if (page < totalPages - 2) pages.push("...");
      pages.push(totalPages);
    }

    for (const p of pages) {
      if (p === "...") {
        html += '<span class="page-ellipsis">…</span>';
      } else {
        html += `<a href="?page=${p}&sort=${sort}" class="page-btn ${p === page ? "active" : ""}" data-page="${p}">${p}</a>`;
      }
    }

    // Next
    html += `<a href="?page=${Math.min(totalPages, page + 1)}&sort=${sort}" class="page-btn ${page >= totalPages ? "disabled" : ""}" data-page="${page + 1}">→</a>`;

    container.innerHTML = html;

    // Intercept pagination clicks (client-side only, no full page reload)
    container.querySelectorAll(".page-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        const newPage = parseInt((btn as HTMLElement).dataset.page || "1");
        if (newPage >= 1 && newPage <= totalPages) {
          updateParams(newPage, sort);
          showPage(newPage);
          renderPagination(newPage, sort);
          window.scrollTo({ top: 0, behavior: "smooth" });
        }
      });
    });
  }

  function updateSortUI(sort: string) {
    const icon = document.getElementById("sort-icon")!;
    const label = document.getElementById("sort-label")!;
    if (sort === "asc") {
      icon.textContent = "🕐";
      label.textContent = "最早在前";
    } else {
      icon.textContent = "🕐";
      label.textContent = "最新在前";
    }
  }

  // Init
  const { page, sort } = getParams();
  applySort(sort);
  showPage(page);
  renderPagination(page, sort);
  updateSortUI(sort);

  // Sort button
  document.getElementById("sort-btn")!.addEventListener("click", () => {
    const { sort } = getParams();
    const newSort = sort === "desc" ? "asc" : "desc";
    updateParams(1, newSort);
    applySort(newSort);
    showPage(1);
    renderPagination(1, newSort);
    updateSortUI(newSort);
  });
</script>
