---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");
const totalPosts = allPosts.length;
---

<BaseLayout title="搜索" totalPosts={totalPosts}>
  <div class="container">
    <section class="search-header">
      <h1>搜索结果</h1>
      <p id="search-query-display"></p>
    </section>
    <section class="search-results-page" id="search-results-page">
      <p class="loading">搜索中...</p>
    </section>
    <nav class="back-nav">
      <a href="/">&larr; 返回首页</a>
    </nav>
  </div>
</BaseLayout>

<style>
  .search-header {
    padding: 2.5rem 0 1rem;
  }
  .search-header h1 {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }
  .search-header p {
    color: var(--text-light);
    font-size: 0.9rem;
  }
  .search-results-page .card {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border-light);
    position: relative;
  }
  .search-results-page .card-overlay {
    position: absolute;
    inset: 0;
    z-index: 0;
    text-decoration: none;
  }
  .search-results-page .card-title {
    margin-bottom: 0.35rem;
    position: relative;
    z-index: 1;
  }
  .search-results-page .card-title-link {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-heading);
    text-decoration: none;
    pointer-events: auto;
  }
  .search-results-page .card-overlay:hover ~ .card-title .card-title-link {
    color: var(--accent);
  }
  .search-results-page .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8rem;
    color: var(--text-light);
    margin-bottom: 0.25rem;
    position: relative;
    z-index: 1;
    pointer-events: none;
  }
  .search-results-page .card-meta time {
    pointer-events: none;
  }
  .search-results-page .card-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    pointer-events: auto;
  }
  .search-results-page .tag-badge {
    display: inline-block;
    font-size: 0.68rem;
    color: var(--text-muted);
    background: var(--accent-bg);
    padding: 0.12em 0.5em;
    border-radius: 4px;
    text-decoration: none;
    line-height: 1.5;
  }
  .search-results-page .tag-badge:hover {
    background: var(--bg-hover);
    text-decoration: none;
  }
  .loading, .no-results {
    padding: 3rem 0;
    color: var(--text-light);
    text-align: center;
  }
</style>

<script>
  const params = new URLSearchParams(window.location.search);
  const query = params.get("q")?.trim() || "";
  const display = document.getElementById("search-query-display")!;
  const container = document.getElementById("search-results-page")!;

  if (!query) {
    display.textContent = "请输入搜索关键词";
    container.innerHTML = '<p class="no-results">请在搜索栏输入关键词后按回车</p>';
  } else {
    display.textContent = `关键词："${escapeHtml(query)}"`;

    fetch("/search-index.json")
      .then((r) => r.json())
      .then((index: any[]) => {
        const results = index.filter((post: any) =>
          post.title.toLowerCase().includes(query.toLowerCase())
        );

        if (results.length === 0) {
          container.innerHTML = '<p class="no-results">没有找到匹配的文章</p>';
          return;
        }

        container.innerHTML = results
          .map(
            (post: any) => `
            <article class="card">
              <a href="/posts/${post.slug}/" class="card-overlay" aria-label="${escapeHtml(post.title)}"></a>
              <h2 class="card-title">
                <a href="/posts/${post.slug}/" class="card-title-link">${escapeHtml(post.title)}</a>
              </h2>
              <div class="card-meta">
                <time>${post.date}</time>
                <span class="card-tags">${(post.tags || []).map((t: string) => `<a href="/tags/${encodeURIComponent(t)}" class="tag-badge">${escapeHtml(t)}</a>`).join("")}</span>
              </div>
            </article>`
          )
          .join("");
      })
      .catch(() => {
        container.innerHTML = '<p class="no-results">搜索索引加载失败</p>';
      });
  }

  function escapeHtml(text: string): string {
    const div = document.createElement("div");
    div.textContent = text;
    return div.innerHTML;
  }
</script>
