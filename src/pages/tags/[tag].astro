---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getPublishedPosts, postPath } from "../../lib/posts";
import { SITE_CONFIG } from "../../site.config.ts";

const PAGE_SIZE = SITE_CONFIG.pagination.pageSize;

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const allTags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return allTags.map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const allPosts = await getPublishedPosts();
const posts = allPosts.filter((post) => post.data.tags.includes(tag));
---

<BaseLayout title={`#${tag}`} description={`标签 ${tag} 下的文章`} totalPosts={allPosts.length}>
  <div class="container">
    <section class="tag-header">
      <h1>#{tag}</h1>
      <p>{posts.length} 篇文章</p>
    </section>

    <div class="controls-bar">
      <span></span>
      <button
        type="button"
        class="sort-btn"
        id="sort-btn"
        title="切换排序"
        aria-label="切换为最早文章在前"
      >
        <span>🕐</span>
        <span id="sort-label">最新在前</span>
      </button>
    </div>

    <section class="post-list" id="post-list">
      {posts.map((post) => (
        <div class="post-item" data-date={post.data.date.toISOString()} data-id={post.id}>
          <ArticleCard
            title={post.data.title}
            date={post.data.date}
            href={postPath(post)}
            tags={post.data.tags}
            description={post.data.description}
          />
        </div>
      ))}
    </section>

    <div class="pagination" id="pagination"></div>
    <div id="page-data" data-page-size={PAGE_SIZE} hidden></div>

    <nav class="back-nav">
      <a href="/">&larr; 返回首页</a>
    </nav>
  </div>
</BaseLayout>

<style>
  .tag-header {
    padding: 2.5rem 0 1rem;
  }
  .tag-header h1 {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }
  .tag-header p {
    color: var(--text-light);
    font-size: 0.9rem;
  }
  .controls-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-light);
    margin-bottom: 0.5rem;
  }
  .sort-btn {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    font-size: 0.78rem;
    color: var(--text-muted);
    cursor: pointer;
    white-space: nowrap;
    font-family: inherit;
  }
  .sort-btn:hover {
    background: var(--bg-hover);
  }
  .post-list {
    padding: 0.5rem 0 1rem;
  }
  .post-item {
    display: block;
  }
  .post-item.hidden {
    display: none;
  }
  .back-nav {
    padding: 1.5rem 0 3rem;
    border-top: 1px solid var(--border-light);
  }
  .back-nav a {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>

<script>
  import { initPostListControls } from "../../scripts/postListControls";
  initPostListControls();
</script>
