---
import TagBadge from "./TagBadge.astro";
import { formatPostDate } from "../lib/dates";

export interface Props {
  title: string;
  date: Date;
  href: string;
  tags: string[];
  description?: string;
}

const { title, date, href, tags, description } = Astro.props;
const dateTime = date.toISOString();
const formattedDate = formatPostDate(date);
---

<article class="card">
  <!-- Invisible overlay link — covers entire card -->
  <a href={href} class="card-overlay" aria-label={title}></a>

  <h2 class="card-title">
    <a href={href} class="card-title-link">{title}</a>
  </h2>
  <div class="card-meta">
    <time datetime={dateTime}>{formattedDate}</time>
    {tags.length > 0 && (
      <span class="card-tags">
        {tags.map((tag) => <TagBadge tag={tag} />)}
      </span>
    )}
  </div>
  {description && <p class="card-desc">{description}</p>}
</article>

